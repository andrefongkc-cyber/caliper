# Copy to .env for local settings. .env is gitignored: never commit it.
# Caliper doesn't load .env itself; export these in your shell (or use a tool that
# loads .env) before starting the app. Placeholders only: never put a real key here.

# Claude Desktop over MCP (docs/mcp.md): the main way in. Needs no API key.
# The Caliper window listens for caliper-mcp unless this is "off".
# CALIPER_MCP=off
# Another socket path, for both the app and caliper-mcp (default ~/.caliper/mcp.sock).
# CALIPER_MCP_SOCKET=

# The in-app assistant over the Anthropic API: the second way in.
# Off unless set to "claude". Needs: uv sync --extra ai
# CALIPER_ASSISTANT=claude
# Which Claude model the assistant uses (optional; caliper/ai/claude.py has the default).
# CALIPER_AI_MODEL=

# Read by the Anthropic SDK only, never by Caliper, and never sent to the model.
# Or skip it and sign in with: ant auth login
# ANTHROPIC_API_KEY=
